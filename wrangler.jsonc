{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imo360-worker-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-09",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    "APP_ENV": "local",
    "URL_IMO360": "https://app.imo360crm.pt",
    "USE_CLOUDFLARE_IMAGES": "true",
    "CF_IMAGES_BASE_URL": "https://images.crm360.pt",
    "CF_IMAGES_VARIANT": "public",
    "USER_IMAGE_PATH_TEMPLATE": "users/{user_hash}/imagens/{file}",
    "EMPREENDIMENTO_IMAGE_PATH_TEMPLATE": "users/{agency_hash}/empreendimento/{empreendimento_hash}/{file}",
    "WEBSITE_DEFAULT_PATH": "users/{hash}/website",
    "IMOVEL_DEFAULT_PATH": "imoveis/{hash}/{type}",
    "HASHIDS_MIN_LENGTH": "6",
    "HASHIDS_ALPHABET": "abcdefghijklmnopqrstuvwxyz1234567890",
    "HASHIDS_ALTERNATIVE_MIN_LENGTH": "25",
    "HASHIDS_ALTERNATIVE_ALPHABET": "abcdefghijklmnopqrstuvwxyz1234567890",
    "CACHE_TTL_WEBSITE": "2592000",
    "CACHE_TTL_IMOVEIS": "300",
    "CACHE_TTL_PREVIEW": "300"
  },

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "42bd76cce69844069b2b045dd9044ed8",
      "localConnectionString": "mysql://imo360crm_uBjHvszuHhEfQnKmh:qD7rBoQ1gts20K5hWDuljPsEYWe0u0@141.95.54.69:3306/imo360crm_FCcEAyZyQvPypvntZAehExnSL"
    }
  ],

  "env": {
    "imo360": {
      "name": "imo360-api",
      "vars": {
        "APP_ENV": "production",
        "URL_IMO360": "https://app.imo360crm.pt",
        "USE_CLOUDFLARE_IMAGES": "true",
        "CF_IMAGES_BASE_URL": "https://images.crm360.pt",
        "CF_IMAGES_VARIANT": "public",
        "USER_IMAGE_PATH_TEMPLATE": "users/{user_hash}/imagens/{file}",
        "EMPREENDIMENTO_IMAGE_PATH_TEMPLATE": "users/{agency_hash}/empreendimento/{empreendimento_hash}/{file}",
        "WEBSITE_DEFAULT_PATH": "users/{hash}/website",
        "IMOVEL_DEFAULT_PATH": "imoveis/{hash}/{type}",
        "HASHIDS_MIN_LENGTH": "6",
        "HASHIDS_ALPHABET": "abcdefghijklmnopqrstuvwxyz1234567890",
        "HASHIDS_ALTERNATIVE_MIN_LENGTH": "25",
        "HASHIDS_ALTERNATIVE_ALPHABET": "abcdefghijklmnopqrstuvwxyz1234567890",
        "CACHE_TTL_WEBSITE": "2592000",
        "CACHE_TTL_IMOVEIS": "300",
        "CACHE_TTL_PREVIEW": "300"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "42bd76cce69844069b2b045dd9044ed8",
          "localConnectionString": "mysql://imo360crm_uBjHvszuHhEfQnKmh:qD7rBoQ1gts20K5hWDuljPsEYWe0u0@141.95.54.69:3306/imo360crm_FCcEAyZyQvPypvntZAehExnSL"
        }
      ]
    },
    "arys": {
      "name": "arys-worker",
      "vars": {
        "APP_ENV": "production",
        "URL_IMO360": "https://arys.imo360.pt",
        "USE_CLOUDFLARE_IMAGES": "true",
        "CF_IMAGES_BASE_URL": "https://lysgroup.crm360.pt",
        "CF_IMAGES_VARIANT": "public",
        "USER_IMAGE_PATH_TEMPLATE": "users/{user_hash}/imagens/{file}",
        "EMPREENDIMENTO_IMAGE_PATH_TEMPLATE": "users/{agency_hash}/empreendimento/{empreendimento_hash}/{file}",
        "WEBSITE_DEFAULT_PATH": "users/{hash}/website",
        "IMOVEL_DEFAULT_PATH": "imoveis/{hash}/{type}",
        // Hashids ARYS (conforme configuracao atual do projeto)
        "HASHIDS_MIN_LENGTH": "15",
        "HASHIDS_ALPHABET": "abcdefghijklmnopqrstuvwxyz1234567890",
        "HASHIDS_ALTERNATIVE_MIN_LENGTH": "40",
        "HASHIDS_ALTERNATIVE_ALPHABET": "abcdefghijklmnopqrstuvwxyz1234567890",
        "CACHE_TTL_WEBSITE": "2592000",
        "CACHE_TTL_IMOVEIS": "300",
        "CACHE_TTL_PREVIEW": "300"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "2dbd943a21314482b177ed4dcc6435f4",
          // Opcional para desenvolvimento local sem --remote
          "localConnectionString": "mysql://imo360_9ymT24p4rvfmZLme:40APv5iN1K0qrm2mGfMoT5lNq68ot8@162.19.231.65:3306/imo360_7gij4qQj0gi3sqh75KSFH50k6"
        }
      ]
    }
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },"env": {"arys":{"name":"arys-worker"}}
}